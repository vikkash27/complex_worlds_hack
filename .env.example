## Copy to `.env` and fill values.
## Never commit `.env` (it contains secrets).

# Live Gemini for score_progress (set one key; uses symbolic fallback if unset)
# ROBOCEREBRA_FORCE_SYMBOLIC_VLM=1
GEMINI_API_KEY=""
# GOOGLE_API_KEY=""
# GEMINI_MODEL=gemini-2.5-flash
# ROBOCEREBRA_REWARD_CACHE=.openreward/gemini_reward_cache.json

# Optional (only needed if you later deploy to OpenReward hosted)
OPENREWARD_API_KEY=""
OPENREWARD_URL="https://openreward.ai"

# Isaac humanoid replay: official Unitree G1 assets fetched by scripts/isaac/fetch_unitree_g1_assets.py
# ROBOCEREBRA_UNITREE_ASSET_DIR="/workspace/complex_worlds_hack/artifacts/isaac/vendor/unitree"
# ROBOCEREBRA_HUMANOID_USD="/workspace/complex_worlds_hack/artifacts/isaac/vendor/unitree/unitree_model/G1/g1.usd"
# ROBOCEREBRA_HUMANOID_SCALE=1.0
# ROBOCEREBRA_HUMANOID_PROXY=0

