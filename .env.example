## Copy to `.env` and fill values.
## Never commit `.env` (it contains secrets).

# Gemini VLM reward scoring (pick one)
GEMINI_API_KEY=""
# GOOGLE_API_KEY=""

# Optional (only needed if you later deploy to OpenReward hosted)
OPENREWARD_API_KEY=""
OPENREWARD_URL="https://openreward.ai"

